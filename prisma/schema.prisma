generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String    @default("user")
  disabledAt    DateTime?
  streakCount   Int       @default(0)
  lastActiveDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  pushSubscriptions PushSubscription[]
  blockedUsers      UserBlock[]       @relation("BlockedBy")
  blockingUsers     UserBlock[]       @relation("Blocking")
  badges            UserBadge[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String?
  bio         String?
  photos      String[]
  gender      String?
  birthDate   String?
  location    String?
  interests   String[]
  lookingFor  String[] @default([])
  job         String?
  verifiedAt  DateTime?
  boostedUntil DateTime?
  lastBoostedAt DateTime?
  discoveryMode String  @default("global") // 'global' | 'event'
  prefAgeMin  Int      @default(18)
  prefAgeMax  Int      @default(99)
  prefShowMe  String   @default("Everyone") // 'Women' | 'Men' | 'Everyone'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}

model UserBlock {
  id         String   @id @default(uuid())
  blockerId  String
  blocker    User     @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId  String
  blocked    User     @relation("Blocking", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Event {
  id          String                  @id @default(uuid())
  code        String                  @unique
  name        String
  photo       String?
  description String?
  location    String?
  createdById String
  isActive    Boolean                 @default(true)
  isPublic    Boolean                 @default(true)
  mysteryMode Boolean                 @default(false)
  sponsorName String?
  sponsorLogo String?
  sponsorFrameUrl String?
  createdAt   DateTime                @default(now())
  expiresAt    DateTime?
  maxAttendees Int?
  startsAt     DateTime?
  endedAt      DateTime?
  attendees    EventAttendee[]
  blockedUsers EventBlockedUser[]
  organizerMessages EventOrganizerMessage[]
  swipes      EventSwipe[]
  matches     EventMatch[]
  waitlist    EventWaitlist[]
  posts       EventPost[]

  @@index([isPublic, isActive])
  @@index([createdById])
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  removedById String?
  removedAt   DateTime?

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, leftAt])
}

model EventWaitlist {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([eventId, userId])
}

model EventBlockedUser {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  blockedById String
  reason      String?
  blockedAt   DateTime @default(now())

  @@unique([eventId, userId])
}

model EventOrganizerMessage {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  readAt     DateTime?
}

model EventPost {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

model EventSwipe {
  id        String   @id @default(uuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  swiperId  String
  swipedId  String
  direction String // like | pass | super
  createdAt DateTime @default(now())

  @@unique([eventId, swiperId, swipedId])
  @@index([eventId, swipedId, direction])
  @@index([swiperId])
}

model EventMatch {
  id                 String          @id @default(uuid())
  eventId            String?
  event              Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user1Id            String
  user2Id            String
  createdAt          DateTime        @default(now())
  messagesUnlockedAt DateTime?
  messages           EventMessage[]

  @@index([eventId, user1Id])
  @@index([eventId, user2Id])
}

model EventMessage {
  id        String     @id @default(uuid())
  matchId   String
  match     EventMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  type      String     @default("text")
  content   String
  audioUrl  String?
  createdAt DateTime   @default(now())
  readAt    DateTime?

  @@index([matchId, createdAt])
  @@index([senderId])
}

model Report {
  id         String   @id @default(uuid())
  eventId    String?
  reporterId String
  reportedId String
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // like | match | message | organizer_message | request | request_accepted
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  earnedAt  DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

model Todo {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
}

model EventMessageRequest {
  id         String   @id @default(uuid())
  eventId    String?
  senderId   String
  receiverId String
  status     String   // pending | accepted | declined
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([eventId, senderId, receiverId])
}

