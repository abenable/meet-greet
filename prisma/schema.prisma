generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String    @default("user")
  disabledAt    DateTime?
  streakCount   Int       @default(0)
  // Presence heartbeat. Written at most once per PRESENCE_WRITE_INTERVAL_MS.
  lastActiveDate DateTime?
  // Streak bookkeeping lives in its own column so the presence heartbeat can't
  // clobber the value the streak calculation reads.
  lastStreakDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  pushSubscriptions PushSubscription[]
  blockedUsers      UserBlock[]       @relation("BlockedBy")
  blockingUsers     UserBlock[]       @relation("Blocking")
  badges            UserBadge[]
  profile           Profile?
  attendances       EventAttendee[]
  swipesGiven       EventSwipe[]      @relation("SwipesGiven")
  swipesReceived    EventSwipe[]      @relation("SwipesReceived")
  matchesAsUser1    EventMatch[]      @relation("MatchUser1")
  matchesAsUser2    EventMatch[]      @relation("MatchUser2")
  messagesSent      EventMessage[]
  notifications     Notification[]
  reportsMade       Report[]          @relation("ReportsMade")
  reportsReceived   Report[]          @relation("ReportsReceived")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  // Failed verification attempts against this record. The record is destroyed
  // once this passes OTP_MAX_ATTEMPTS so a 6-digit code can't be walked.
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  bio         String?
  photos      String[]
  gender      String?
  birthDate   String?
  location    String?
  interests   String[]
  lookingFor  String[] @default([])
  job         String?
  // Set only by an admin review (server/admin.ts). Users submit a capture,
  // which lands in the three fields below; they cannot grant themselves the
  // badge.
  verifiedAt  DateTime?
  verificationPhoto       String?
  verificationSubmittedAt DateTime?
  verificationStatus      String?   // null | 'pending' | 'approved' | 'rejected'
  boostedUntil DateTime?
  lastBoostedAt DateTime?
  discoveryMode String  @default("global") // 'global' | 'event'
  prefAgeMin  Int      @default(18)
  prefAgeMax  Int      @default(99)
  prefShowMe  String   @default("Everyone") // 'Women' | 'Men' | 'Everyone'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt

  // Global discovery pages over this; boostedUntil orders the first page.
  @@index([discoveryMode, boostedUntil])
  @@index([verificationStatus, verificationSubmittedAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}

model UserBlock {
  id         String   @id @default(uuid())
  blockerId  String
  blocker    User     @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId  String
  blocked    User     @relation("Blocking", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Event {
  id          String                  @id @default(uuid())
  code        String                  @unique
  name        String
  photo       String?
  description String?
  location    String?
  createdById String
  isActive    Boolean                 @default(true)
  isPublic    Boolean                 @default(true)
  mysteryMode Boolean                 @default(false)
  sponsorName String?
  sponsorLogo String?
  sponsorFrameUrl String?
  createdAt   DateTime                @default(now())
  expiresAt    DateTime?
  maxAttendees Int?
  startsAt     DateTime?
  endedAt      DateTime?
  attendees    EventAttendee[]
  blockedUsers EventBlockedUser[]
  organizerMessages EventOrganizerMessage[]
  swipes      EventSwipe[]
  matches     EventMatch[]
  waitlist    EventWaitlist[]
  posts       EventPost[]

  @@index([isPublic, isActive])
  @@index([createdById])
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  removedById String?
  removedAt   DateTime?

  @@unique([eventId, userId])
  @@index([userId])
  @@index([userId, leftAt])
  @@index([eventId, leftAt])
  @@index([userId, joinedAt])
}

model EventWaitlist {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, joinedAt])
}

model EventBlockedUser {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  blockedById String
  reason      String?
  blockedAt   DateTime @default(now())

  @@unique([eventId, userId])
}

model EventOrganizerMessage {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  readAt     DateTime?

  // getConversations filters on sender/receiver without an eventId, so each
  // side needs its own leading-column index.
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([receiverId, readAt])
  @@index([eventId, senderId, receiverId, createdAt])
}

model EventPost {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

model EventSwipe {
  id        String   @id @default(uuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  swiperId  String
  swiper    User     @relation("SwipesGiven", fields: [swiperId], references: [id], onDelete: Cascade)
  swipedId  String
  swiped    User     @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)
  direction String // like | pass | super
  createdAt DateTime @default(now())

  // NOTE: this compound unique does not dedupe rows where eventId IS NULL.
  // Global swipes are covered by the partial unique index
  // "EventSwipe_global_swiper_swiped_key" (see 20260909200622_global_discovery).
  @@unique([eventId, swiperId, swipedId])
  @@index([eventId, swipedId, direction])
  @@index([swiperId])
  @@index([swiperId, eventId])
  @@index([swipedId, direction])
}

model EventMatch {
  id                 String          @id @default(uuid())
  eventId            String?
  event              Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user1Id            String
  user1              User            @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id            String
  user2              User            @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  messagesUnlockedAt DateTime?
  messages           EventMessage[]

  // Every read filters `OR [user1Id, user2Id]` with no eventId, so eventId
  // cannot be the leading column. Uniqueness of the pair is enforced by two
  // partial unique indexes (event-scoped and global) added in the migration.
  @@index([user1Id, createdAt])
  @@index([user2Id, createdAt])
  @@index([eventId])
}

model EventMessage {
  id        String     @id @default(uuid())
  matchId   String
  match     EventMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type      String     @default("text")
  content   String
  audioUrl  String?
  createdAt DateTime   @default(now())
  readAt    DateTime?

  @@index([matchId, createdAt])
  @@index([senderId])
  // Unread-count groupBy: matchId + "not me" + readAt IS NULL.
  @@index([matchId, readAt, senderId])
}

model Report {
  id         String   @id @default(uuid())
  eventId    String?
  reporterId String
  reporter   User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User     @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  // Auto-moderation groups by reportedId over pending reports in a time window.
  @@index([reportedId, status, createdAt])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  // One report per reporter/target/event. Global reports (eventId IS NULL) are
  // deduped by a partial unique index added in the migration.
  @@unique([reporterId, reportedId, eventId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // like | match | message | organizer_message | request | request_accepted
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  earnedAt  DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

model EventMessageRequest {
  id         String   @id @default(uuid())
  eventId    String?
  senderId   String
  receiverId String
  status     String   // pending | accepted | declined
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Global requests (eventId IS NULL) are deduped by a partial unique index
  // added in the migration, for the same NULL-distinct reason as EventSwipe.
  @@unique([eventId, senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

