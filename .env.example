# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth
BETTER_AUTH_SECRET=
# Must be the public origin in production — it anchors cookie scope and the
# trusted-origin check.
BETTER_AUTH_URL=
# Optional: extra origins allowed to drive auth, comma-separated.
ADDITIONAL_TRUSTED_ORIGINS=

# Mailtrap (for sending emails)
MAILTRAP_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Set to 1 (or the number of proxy hops) ONLY when a reverse proxy you control
# overwrites x-forwarded-for. Left at 0, rate limits key off the socket address
# instead of a spoofable header.
#
# Do set it if you deploy behind nginx/Caddy/Cloudflare/a load balancer: the
# socket address is then the *proxy*, so every user shares a single rate-limit
# bucket and the OTP limits throttle the whole app at once.
TRUST_PROXY=0

# Sentry. Sampling defaults are deliberately low; PII is off.
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
